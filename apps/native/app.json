{
  "expo": {
    "name": "moojot",
    "slug": "moojot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moojot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.moojot",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F15F78",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.READ_MEDIA_IMAGES", "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"],
      "blockedPermissions": ["android.permission.WRITE_EXTERNAL_STORAGE"],
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.moojot"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFDA60",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "อนุญาตให้หมูจดเข้าถึงรูปภาพทั้งหมด เพื่อนับรูปในอัลบั้มสลิปย้อนหลัง 30 วันบนเครื่อง และให้คุณเลือกนำเข้าสลิป",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "อนุญาตให้หมูจดอ่านอัลบั้มรูปภาพ เพื่อนับสลิปย้อนหลัง 30 วันในเครื่อง",
          "savePhotosPermission": false,
          "granularPermissions": ["photo"],
          "preventAutomaticLimitedAccessAlert": true
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
