{
  "name": "@moojot/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "node scripts/patch-prisma-generated.mjs && tsc -b",
    "check-types": "node scripts/patch-prisma-generated.mjs && tsc -b",
    "db:push": "prisma db push && node scripts/patch-prisma-generated.mjs",
    "db:generate": "prisma generate && node scripts/patch-prisma-generated.mjs",
    "db:generate:client": "node scripts/generate-client.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@moojot/config": "workspace:*",
    "prisma": "6.19.3",
    "typescript": "^7.0.2",
    "varlock": "catalog:"
  }
}
